# ================================
# mdBook
# ================================
book/
book.toml.bak

# mdbook binary (install locally, don't track)
mdbook
mdbook.exe

# mdbook plugins (if compiled from source)
*.so
*.dylib
*.dll

# ================================
# Build artifacts
# ================================
target/
dist/
build/
*.o
*.a
*.lib

# ================================
# OS generated files
# ================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ================================
# Editor / IDE files
# ================================
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.project
.classpath
.settings/

# ================================
# Node.js (if tooling added)
# ================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# NOTE: package.json / lockfiles are intentionally NOT ignored — the real
# mermaid@11 + jsdom parser step in scripts/validate-all.sh depends on them, and
# ignoring them made that environment unreproducible from a fresh clone.
yarn.lock

# ================================
# Python (if scripts added)
# ================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/

# ================================
# Rust / Cargo
# ================================
# Cargo.toml / Cargo.lock are NOT ignored: this book has no Rust build today,
# but blanket-ignoring a build manifest silently swallows one if it is added.
target/

# ================================
# Temp / backup files
# ================================
*.tmp
*.bak
*.log
*.orig
*~
.#*
\#*#

# ================================
# Misc
# ================================
*.cache
.env
.env.local
token.txt
mermaid-validation-report.json
scripts/mermaid-validate-report.json
