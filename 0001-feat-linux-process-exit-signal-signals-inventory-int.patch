+if os.WIFEXITED(status):
+    code = os.WEXITSTATUS(status)         # normal exit, 0-255
+elif os.WIFSIGNALED(status):
+    sig = os.WTERMSIG(status)             # e.g. 15 -> shell $? would be 143
+    coredump = os.WCOREDUMP(status)
